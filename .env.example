# ==============================================================================
# Environment Configuration for MERN Portfolio Website
# ==============================================================================

# Port for Express API and Unified Static Server (Default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
# If omitted, the server operates in Fallback Data Mode using high-fidelity in-memory data
MONGODB_URI=
